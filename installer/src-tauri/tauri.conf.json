{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Upgraded",
  "version": "0.2.4",
  "identifier": "com.venacity.steamupgraded.installeur",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Installer Steam Upgraded",
        "width": 760,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
